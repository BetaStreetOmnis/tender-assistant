# 环境配置示例文件

# 应用配置
APP_NAME=tender-assistant
APP_ENV=development
DEBUG=True
SECRET_KEY=your-secret-key-here

# 数据库配置
DATABASE_URL=postgresql://user:password@localhost:5432/tender_db
DATABASE_ECHO=False

# Redis配置
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# Milvus配置（可选）
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=

# Neo4j配置（可选）
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# LLM配置
# 通义千问
DASHSCOPE_API_KEY=your-qwen-api-key

# OpenAI（可选）
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1

# Deepseek（可选）
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 文件存储
UPLOAD_DIR=storage/uploads
TEMPLATE_DIR=storage/templates
GENERATED_DIR=storage/generated
MAX_UPLOAD_SIZE=52428800  # 50MB

# Celery配置
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# CORS配置
CORS_ORIGINS=["http://localhost:3000"]

# JWT配置
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440  # 24小时

# 业务配置
DEFAULT_TEMPLATE_TYPE=software
MAX_RAG_RESULTS=10
ENABLE_KNOWLEDGE_GRAPH=False